function doPost(e){const sh=SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];if(sh.getLastRow()===0)sh.appendRow(['Timestamp','Response','Date Type','Date','Time','Message']);const d=JSON.parse(e.postData.contents||'{}');sh.appendRow([d.timestamp||new Date().toISOString(),d.response||'',d.dateType||'',d.date||'',d.time||'',d.message||'']);return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON);}